# Documentation only: the CLI does not automatically load this file.
# Paths must exist on the selected host; never put secret values here.
TAMER_RECEIPT_ENV=staging
TAMER_RECEIPT_TITLE_ID=TESTTITLE
TAMER_RECEIPT_PRODUCTION_TITLE_ID=PRODTITLE
TAMER_RECEIPT_PACKAGE=com.example.tamer.iaptest
TAMER_RECEIPT_TEST_ACCOUNTS=["TESTACCOUNT"]
TAMER_RECEIPT_PUBLIC_ORIGIN=https://receipt.example.test
TAMER_RECEIPT_BIND=127.0.0.1
TAMER_RECEIPT_PORT=8088
TAMER_RECEIPT_DATA_DIR=/srv/tamer-receipts/data
TAMER_RECEIPT_PLAYFAB_SECRET_FILE=/run/secrets/tamer-playfab-test
TAMER_RECEIPT_GOOGLE_CREDENTIALS_FILE=/run/secrets/tamer-google-test.json
